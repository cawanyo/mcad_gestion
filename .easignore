# Same as .gitignore, except convex/_generated/ — EAS Build archives the
# project from a git-based tarball that respects .gitignore, which excludes
# convex/_generated/ (regenerated locally, never committed). The mobile app
# imports from it directly (App.tsx: `../convex/_generated/api`), so the
# EAS build machine needs it present. Presence of this file makes EAS CLI
# use these rules INSTEAD of .gitignore, not in addition to it — so every
# other .gitignore rule is repeated here on purpose.

# dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js & builds
.next/
*/.next/
out/
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Expo & React Native
.expo/
*/.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# SQLite Dev Databases
*.db
*.db-journal
dev.db
.env
