datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  phone        String?   @unique
  email        String?
  password     String?
  gender       String?   @default("HOMME") // HOMME, FEMME
  birthDate    DateTime?
  avatar       String?
  role         String    @default("MEMBER") // SUPER_ADMIN, DEPARTMENT_LEADER, POLE_LEADER, CALENDAR_MANAGER, MEMBER
  status       String    @default("ACTIVE")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  poleMemberships    PoleMembership[]
  poleLeaderships    PoleLeader[]
  membershipRequests MembershipRequest[] @relation("UserRequests")
  reviewedRequests   MembershipRequest[] @relation("ReviewedRequests")
  assignments        Assignment[]        @relation("UserAssignments")
  createdAssignments Assignment[]        @relation("AssignedBy")
  interests          MemberInterest[]
  unavailabilities   Unavailability[]
  checklistExecutions ChecklistExecution[]
  serviceValidations ServiceValidation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  trainingProgress   TrainingModuleProgress[]
  lessonCompletions  TrainingLessonCompletion[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  settings    String?  // JSON string
  
  users       User[]
  poles       Pole[]
  events      Event[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pole {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  color        String     @default("#3b68f0")
  icon         String     @default("Users")
  orderIndex   Int        @default(0)
  status       String     @default("ACTIVE")

  leaders            PoleLeader[]
  memberships        PoleMembership[]
  membershipRequests MembershipRequest[]
  eventRequirements  EventRequirement[]
  assignments        Assignment[]
  interests          MemberInterest[]
  checklists         Checklist[]
  organizedEvents    Event[]             @relation("OrganizedPole")
  serviceValidations ServiceValidation[]
  trainingModules    TrainingModule[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model PoleLeader {
  id        String   @id @default(cuid())
  poleId    String
  pole      Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle String?  @default("Responsable de pôle")

  createdAt DateTime @default(now())

  @@unique([poleId, userId])
}

model PoleMembership {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poleId   String
  pole     Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  status   String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, poleId])
}

model MembershipRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  poleId       String
  pole         Pole      @relation(fields: [poleId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  motivation   String?
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Event {
  id                String   @id @default(cuid())
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizerPoleId   String?
  organizerPole     Pole?    @relation("OrganizedPole", fields: [organizerPoleId], references: [id])
  title             String
  description       String?
  startsAt          DateTime
  endsAt            DateTime
  location          String
  status            String   @default("PUBLISHED") // DRAFT, PUBLISHED, COMPLETED, CANCELLED
  coverImage        String?
  recurrenceRule    String?  // NONE, WEEKLY, BIWEEKLY, MONTHLY
  recurrenceGroupId String?  // ID grouping recurring event instances

  requirements      EventRequirement[]
  assignments       Assignment[]
  interests         MemberInterest[]
  eventChecklists   EventChecklist[]
  checklistExecutions ChecklistExecution[]
  serviceValidations ServiceValidation[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EventRequirement {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poleId        String
  pole          Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  requiredCount Int      @default(1)
  notes         String?
  roleExpected  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([eventId, poleId])
}

model Assignment {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poleId       String
  pole         Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  roleTag      String?
  status       String   @default("CONFIRMED") // CONFIRMED, DECLINED, PENDING

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([eventId, userId])
}

model MemberInterest {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poleId    String
  pole      Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     String?

  createdAt DateTime @default(now())

  @@unique([eventId, userId, poleId])
}

model Unavailability {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  recurrence String   @default("NONE") // NONE, WEEKLY, BIWEEKLY, MONTHLY

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Checklist {
  id          String   @id @default(cuid())
  poleId      String
  pole        Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("ACTIVE")
  orderIndex  Int      @default(0)

  steps       ChecklistStep[]
  eventChecklists EventChecklist[]
  executions  ChecklistExecution[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChecklistStep {
  id             String    @id @default(cuid())
  checklistId    String
  checklist      Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  orderIndex     Int       @default(0)
  title          String
  description    String?
  details        String?   // Bullet points / description
  mediaType      String    @default("NONE") // NONE, PHOTO, VIDEO, TEXT
  mediaUrl       String?
  mediaThumbnail String?
  isRequired     Boolean   @default(true)

  executionSteps ChecklistExecutionStep[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model EventChecklist {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@unique([eventId, checklistId])
}

model ChecklistExecution {
  id          String    @id @default(cuid())
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  poleId      String?
  status      String    @default("COMPLETED") // IN_PROGRESS, COMPLETED, VALIDATED
  comment     String?   // Feedback and observation from the member
  
  stepsCompleted ChecklistExecutionStep[]
  serviceValidation ServiceValidation?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ChecklistExecutionStep {
  id          String             @id @default(cuid())
  executionId String
  execution   ChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepId      String
  step        ChecklistStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completed   Boolean            @default(false)
  completedAt DateTime?

  @@unique([executionId, stepId])
}

model ServiceValidation {
  id                   String    @id @default(cuid())
  eventId              String
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poleId               String
  pole                 Pole      @relation(fields: [poleId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistExecutionId String?   @unique
  checklistExecution   ChecklistExecution? @relation(fields: [checklistExecutionId], references: [id])
  status               String    @default("PENDING") // PENDING, VALIDATED, REJECTED
  comment              String?   // Mandatory when validating
  rating               Int?
  validatedAt          DateTime?
  reminderSentAt       DateTime?
  reminderCount        Int       @default(0)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([eventId, userId, poleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?

  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    String?  // JSON string

  createdAt  DateTime @default(now())
}

model TrainingModule {
  id                String   @id @default(cuid())
  poleId            String
  pole              Pole     @relation(fields: [poleId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  coverImage        String?
  level             String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedDuration String?  @default("30 min")
  orderIndex        Int      @default(0)
  status            String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED

  lessons           TrainingLesson[]
  userProgress      TrainingModuleProgress[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TrainingLesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  content         String?  // Rich content / guide / instructions
  mediaType       String   @default("NONE") // NONE, VIDEO, PHOTO, DOCUMENT
  mediaUrl        String?
  durationMinutes Int?     @default(10)
  orderIndex      Int      @default(0)

  completions     TrainingLessonCompletion[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrainingLessonCompletion {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([userId, lessonId])
}

model TrainingModuleProgress {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId              String
  module                TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status                String         @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED
  progressPercent       Float          @default(0.0)
  completedLessonsCount Int            @default(0)
  totalLessonsCount     Int            @default(0)
  startedAt             DateTime       @default(now())
  completedAt           DateTime?
  lastAccessedAt        DateTime       @default(now())

  @@unique([userId, moduleId])
}

