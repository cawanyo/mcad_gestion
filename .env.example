# Convex deployment (see `npx convex dashboard`)
NEXT_PUBLIC_CONVEX_URL="https://[DEPLOYMENT_NAME].convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://[DEPLOYMENT_NAME].convex.site"

# Only needed in CI (Vercel build command: npx convex deploy --cmd 'npm run build')
# CONVEX_DEPLOY_KEY="prod:[DEPLOYMENT_NAME]|..."

# Nom de l'application
NEXT_PUBLIC_APP_NAME="MCAD"

# Compte Super Administrateur
ADMIN_FIRST_NAME="Prénom"
ADMIN_LAST_NAME="Nom"
ADMIN_PHONE="+33 6 00 00 00 00"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="[CHOISISSEZ_UN_MOT_DE_PASSE]"
ADMIN_ROLE="SUPER_ADMIN"

# Cloudinary Media Storage (Photos, Vidéos, Avatars)
CLOUDINARY_API_SECRET="[VOTRE_CLOUDINARY_API_SECRET]"
CLOUDINARY_API_KEY="[VOTRE_CLOUDINARY_API_KEY]"
CLOUDINARY_CLOUD_NAME="[VOTRE_CLOUDINARY_CLOUD_NAME]"


